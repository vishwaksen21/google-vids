# Vids Production — every setting, with its default. Copy to backend/.env and fill in.
# Never commit backend/.env. Nothing here is a Google password: there is no such setting.

# ------------------------------------------------------------------ application
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://vidsprod:CHANGE_ME@localhost:5432/vids
TEST_DATABASE_URL=postgresql+asyncpg://vidsprod:CHANGE_ME@localhost:5432/vids_test
API_TOKEN=                          # required in production; the dashboard proxy sends it
CORS_ORIGINS=http://localhost:3000
# ARTIFACT_DIR=../var/artifacts      # screenshots, frames, clips, exports, reports
# DESIGN_MD_PATH=../../DESIGN.md
# LOGO_PATH=../../logo.png
MAX_REQUEST_BYTES=1000000

# ------------------------------------------------------------------ worker
WORKER_EMBEDDED=true                # the API process runs the worker (required with a real browser)
WORKER_POLL_SECONDS=1.0
WORKER_LEASE_SECONDS=60

# ------------------------------------------------------------------ AI provider
AI_PROVIDER=gateway                 # gateway (default) | gemini | fake (not allowed in production)
AI_TIMEOUT_SECONDS=120
AI_MAX_ATTEMPTS=3
AI_BACKOFF_BASE_SECONDS=2
AI_STRUCTURED_REPAIR_ATTEMPTS=1
AI_MODEL_CREATIVE=gemini-3.1-pro-preview
AI_MODEL_REASONING=gemini-3.1-pro-preview
AI_MODEL_VISION=gemini-3.8-flash
AI_MODEL_TRANSCRIBE=gemini-3.8-flash
# AI_COST_PER_MTOK_INPUT=           # optional, for the request log's cost column
# AI_COST_PER_MTOK_OUTPUT=

# Company gateway (Vertex AI behind the company's Utils Gateway)
GATEWAY_BASE_URL=
GATEWAY_API_KEY=
GATEWAY_TEXT_PATH=/llm/generate
GATEWAY_MODELS_PATH=/llm/models
GATEWAY_LOCATION=global
GATEWAY_THINKING_BUDGET=1024
GATEWAY_STRUCTURED_MODE=schema      # schema | prompt

# Direct Gemini: off until direct data handling is approved
GEMINI_DIRECT_ENABLED=false
GEMINI_API_KEY=
GEMINI_STORE_INTERACTIONS=false

# ------------------------------------------------------------------ Google Vids
GOOGLE_VIDS_MODE=mock               # mock | browser_test (real Chrome, read-only) | live
GOOGLE_VIDS_LIVE_AUTOMATION_ENABLED=false   # live actions need mode=live AND this=true
GOOGLE_VIDS_ALLOWED_ACCOUNT=        # the one Google account automation may operate (address only)
GOOGLE_VIDS_URL=https://vids.google.com/
GOOGLE_VIDS_PROJECT_PREFIX=[vidsprod]       # projects the agent may touch; others are refused
# BROWSER_PROFILE_DIR=../var/browser-profile  # owner-only; holds the signed-in session
BROWSER_CHANNEL=chrome              # chrome = installed Google Chrome; empty = bundled Chromium
BROWSER_HEADLESS=false
BROWSER_ACTION_TIMEOUT_MS=15000
BROWSER_GENERATION_TIMEOUT_SECONDS=600
BROWSER_MIN_ACTION_INTERVAL_MS=800  # human pace between actions
# LOCATOR_CATALOGUE_PATH=../recon/locators.json
MOCK_VIDS_SCENARIO=realistic        # clean | realistic | stress (mock mode only)

# ------------------------------------------------------------------ planning
SPEECH_WORDS_PER_SECOND=2.5
SPEECH_DIALOGUE_SHARE=0.8
SPEECH_MIN_FILL_SHARE=0.75
VIDEO_MIN_SECONDS=6
VIDEO_MAX_SECONDS=90
READING_WORDS_PER_SECOND=3.0
MIN_SUPER_SECONDS=2.0

# ------------------------------------------------------------------ production
MAX_TAKES_PER_SCENE=3
MAX_EDITS_PER_SCENE=2
GENERATION_MONTHLY_LIMIT=50         # Google documents ~50 AI generations per user per month
GENERATION_CAMPAIGN_LIMIT=20
STAGE_MAX_ATTEMPTS=3
STAGE_BACKOFF_BASE_SECONDS=5
STAGE_BACKOFF_MAX_SECONDS=300
DURATION_TOLERANCE_SECONDS=0.6
EXPORT_TIMEOUT_SECONDS=900
EXPORT_MIN_BYTES=10000
EXPORT_MAX_BYTES=2000000000

# ------------------------------------------------------------------ approvals
APPROVAL_PLAN_REQUIRED=true
APPROVAL_COMPLIANCE_REQUIRED=true   # always required for a regulated brand profile
DELIVERY_SUBMISSION_TARGET=none     # none | local (requires a SUBMISSION approval)
