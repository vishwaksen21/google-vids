# Copy to .env.local and fill in. Both values are read only on the server
# (by the proxy at app/api/backend/[...path]/route.ts); neither reaches the browser.
# Never prefix these with NEXT_PUBLIC_.

# Bearer token for the Vids Production API. Use the API_TOKEN value from vids/backend/.env.
API_TOKEN=

# Base URL of the FastAPI backend (no trailing slash).
BACKEND_URL=http://localhost:8100
